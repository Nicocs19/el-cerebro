# ================== EL CEREBRO v2 - configuración ==================
# instalar.bat copia este archivo como .env. Rellena lo que tengas; lo demás funciona por defecto.

# --- Teclas (asígnalas también a botones del Loupedeck) ---
HOTKEY=ctrl+shift+f12
CONFIRM_HOTKEY=ctrl+shift+f11
CANCEL_HOTKEY=ctrl+shift+f10
# publicaciones = pide "dale" antes de publicar en Discord | todo = también títulos | nada = ejecuta directo
CONFIRMAR=publicaciones
CONFIRMAR_SEGUNDOS=60

# --- IA local (Ollama) ---
USE_OLLAMA=true
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
# Cómo escribe los anuncios (puedes cambiarlo)
TONO=tono cercano y épico, como un GM de WoW hablándole a su hermandad; español con voseo como Hogger; como mucho 2 emojis; frases cortas

# --- La guild ---
NOMBRE_GUILD=The H's
ROLES_MENCIONABLES=Eventos de la guild,Llamado a bandas,Sorteos,En vivo,Videos nuevos
CANALES_DISCORD=anuncios-guild,general,raids-signup,en-vivo,videos-nuevos,clips-y-memes,builds-y-guias,subidas-de-nivel

# --- Hogger (el mismo token y server que el .env del bot) ---
HOGGER_TOKEN=
HOGGER_GUILD_ID=
CANAL_CEREBRO=cerebro

# --- Respaldo: webhook del canal de anuncios (solo si Hogger no está) ---
DISCORD_WEBHOOK_URL=
DISCORD_MENTION=
DISCORD_NAME=

# --- Kick (app de kick.com/settings/developer) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8765/callback
KICK_CATEGORY_ID=

# --- YouTube (archivo de credenciales OAuth de escritorio de Google Cloud) ---
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_CATEGORY_ID=20

# --- TikTok LIVE Studio: portapapeles | automatico ---
TIKTOK_MODO=portapapeles

# --- OBS WebSocket (Herramientas > Ajustes del servidor WebSocket) ---
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
# Escena o fuente para el fondo de las miniaturas (por ejemplo la captura del juego). Vacío = lo que sale en directo
OBS_FUENTE=

# --- Voz (Whisper local) ---
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8_float16
MIC_DEVICE=
VAD_THRESHOLD=0.015
SILENCE_SECONDS=1.5
MAX_SECONDS=30

# --- Respuesta ---
BEEPS=true
OVERLAY=true
VOICE_FEEDBACK=false
DRY_RUN=false
