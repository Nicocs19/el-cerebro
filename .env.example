# ================== EL CEREBRO v2 - configuración ==================
# instalar.bat copia este archivo como .env. Rellena lo que tengas; lo demás funciona por defecto.

# --- Teclas (asígnalas también a botones del Loupedeck) ---
HOTKEY=ctrl+shift+f12
CONFIRM_HOTKEY=ctrl+shift+f11
CANCEL_HOTKEY=ctrl+shift+f10
# publicaciones = pide "dale" antes de publicar en Discord | todo = también títulos | nada = ejecuta directo
CONFIRMAR=publicaciones
CONFIRMAR_SEGUNDOS=60

# --- IA local (Ollama) ---
USE_OLLAMA=true
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
# Cómo escribe los anuncios (puedes cambiarlo)
TONO=tono cercano y épico, como un GM de WoW hablándole a su hermandad; español con voseo como Hogger; como mucho 2 emojis; frases cortas

# --- La guild ---
NOMBRE_GUILD=The H's
ROLES_MENCIONABLES=Eventos de la guild,Llamado a bandas,Sorteos,En vivo,Videos nuevos
CANALES_DISCORD=anuncios-guild,general,raids-signup,en-vivo,videos-nuevos,clips-y-memes,builds-y-guias,subidas-de-nivel

# --- Hogger (el mismo token y server que el .env del bot) ---
HOGGER_TOKEN=
HOGGER_GUILD_ID=
CANAL_CEREBRO=cerebro

# --- Respaldo: webhook del canal de anuncios (solo si Hogger no está) ---
DISCORD_WEBHOOK_URL=
DISCORD_MENTION=
DISCORD_NAME=

# --- Kick (app de kick.com/settings/developer) ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8765/callback
KICK_CATEGORY_ID=
# Chat del stream: moderación por voz («banea a pepe») y enlaces («mandá el link del discord»)
CHAT_KICK=true
# Número de la sala del chat de Kick (conectar_kick.bat lo guarda solo; poné uno solo si te lo piden)
KICK_CHATROOM_ID=
# Clave del chat de Kick (Pusher). Se actualiza sola si Kick la cambia
# KICK_PUSHER_KEY=34bf7a0ff419a2a775b9
# KICK_PUSHER_CLUSTER=us2
# Minutos de «silenciá a X» si no decís cuánto
SILENCIO_MINUTOS=10

# --- YouTube (archivo de credenciales OAuth de escritorio de Google Cloud) ---
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_CATEGORY_ID=20

# --- TikTok LIVE Studio: portapapeles | automatico ---
TIKTOK_MODO=portapapeles

# --- Modo Jarvis: voz que te habla y orbe animado ---
JARVIS_VOZ=true
JARVIS_ORBE=true
JARVIS_SALUDO=¡El Cerebro en línea! Listo para pensar por los dos.
# ElevenLabs (voz principal; la clave la carga conectar_voz.bat). Sin clave usa la voz local
ELEVEN_API_KEY=
ELEVEN_VOZ=Daniel
ELEVEN_MODELO=eleven_flash_v2_5
# Voz local de respaldo (Piper): es_MX-claude-high, es_MX-ald-medium, es_ES-davefx-medium, es_AR-daniela-high...
VOZ_MODELO=es_MX-claude-high
# Dónde suena la voz (nombre o número de salida de audio, ver: python cerebro.py --salidas). Vacío = la predeterminada
VOZ_DISPOSITIVO=
VOZ_VELOCIDAD=1.1
VOZ_VOLUMEN=0.9
# Voz de dibujito: semitonos más aguda (0 = normal)
VOZ_TONO=4
# jarvis (celeste) o dorado | abajo-derecha, abajo-izquierda, abajo-centro, arriba-derecha, arriba-izquierda
# En pantalla: cerebro (con ojos) u orbe (la bolita). CEREBRO_SIEMPRE=true lo deja siempre visible
ORBE_ESTILO=cerebro
CEREBRO_SIEMPRE=false
ORBE_COLOR=jarvis
ORBE_POSICION=abajo-derecha

# --- OBS WebSocket (Herramientas > Ajustes del servidor WebSocket) ---
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
# Escena o fuente para el fondo de las miniaturas (por ejemplo la captura del juego). Vacío = lo que sale en directo
OBS_FUENTE=
# Miniaturas diseñadas por Claude (con tu idea y las fotos de recursos/imagenes). false = plantilla dorada
MINIATURA_CLAUDE=true
# Overlays por voz: los diseña Claude (programa claude de tu PC). false = cartel simple propio
OVERLAY_CLAUDE=true
OVERLAY_ESPERA=300
# Modelo de Claude para diseñar y ruta a claude.exe (vacía = se busca sola, también la de la app de escritorio)
CLAUDE_MODELO=sonnet
CLAUDE_EXE=

# --- Voz (Whisper local) ---
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8_float16
MIC_DEVICE=
VAD_THRESHOLD=0.015
SILENCE_SECONDS=1.5
MAX_SECONDS=30

# --- Respuesta ---
BEEPS=true
OVERLAY=true
VOICE_FEEDBACK=false
DRY_RUN=false
